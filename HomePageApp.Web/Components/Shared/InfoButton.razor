@implements IAsyncDisposable
@inject IJSRuntime JS

<div @ref="_container"
     class="position-relative d-inline-block">

    <button type="button"
            class="btn btn-sm btn-outline-secondary rounded-circle p-0 info-button"
            @onclick="ToggleInfo"
            aria-label="More information">
        <i class="bi bi-info-lg"></i>
    </button>

    @if (showInfo)
    {
        <div class="info-popover shadow-sm">
            @ChildContent
        </div>
    }
</div>

@code {
    private ElementReference _container;
    private IJSObjectReference? _module;
    private DotNetObjectReference<InfoButton>? _dotNetReference;
    private bool showInfo;

    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./Components/Shared/InfoButton.razor.js");

            _dotNetReference = DotNetObjectReference.Create(this);

            await _module.InvokeVoidAsync("initialize", _container, _dotNetReference);
        }
    }

    private void ToggleInfo()
    {
        showInfo = !showInfo;
    }

    [JSInvokable]
    public Task CloseInfo()
    {
        if (showInfo)
        {
            showInfo = false;
            StateHasChanged();
        }

        return Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _container);
            }
            catch (JSDisconnectedException)
            {
            }

            await _module.DisposeAsync();
        }

        _dotNetReference?.Dispose();
    }
}