@using Microsoft.AspNetCore.Components.Authorization

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">Home Page App</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Home
            </NavLink>
        </div>
        <AuthorizeView>
            <NotAuthorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/Demo/" Match="NavLinkMatch.All">
                        <span class="bi bi-play-circle-fill" aria-hidden="true"></span> Dashboard Demo
                    </NavLink>
                </div>

                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="/Demo/BillTracker">
                        <span class="bi bi-currency-dollar" aria-hidden="true"></span> Bill Tracker Admin
                    </NavLink>
                </div>
            </NotAuthorized>
            <Authorized>
                <div class="nav-item px-3">
                    <NavLink class="nav-link" href="billtracker">
                        <span class="bi bi-currency-dollar" aria-hidden="true"></span> Bill Tracker Admin
                    </NavLink>
                </div>

                <AuthorizeView Roles="Admin">
                    <Authorized Context="AdminContext">
                        <div class="nav-item px-3">
                            <NavLink class="nav-link" href="userAdministration">
                                <span class="bi bi-people" aria-hidden="true"></span> User Administration
                            </NavLink>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </Authorized>
        </AuthorizeView>
    </nav>
</div>

