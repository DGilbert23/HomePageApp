@using Microsoft.AspNetCore.Components.Authorization
@implements IAsyncDisposable
@inject NavigationManager NavigationManager;
@inject IJSRuntime JSRuntime
@inherits LayoutComponentBase


<div class="page">

    @if (!HideMenu)
    {
        <div class="sidebar">
            <NavMenu />
        </div>
    }

    <main class="main-container">
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <div class="top-row-actions">
                        <button class="btn theme-button"
                                @onclick="ToggleTheme"
                                title="Toggle light/dark theme"
                                aria-label="Toggle light/dark theme">
                            <i class="bi @(IsDarkMode ? "bi-sun-fill" : "bi-moon-fill")"></i>
                        </button>

                        <a class="btn btn-outline-primary top-row-button"
                           href="/changepassword">
                            <i class="bi bi-key me-1"></i>
                            Change Password
                        </a>

                        <form method="post" action="/account/logout">
                            <button class="btn btn-outline-danger top-row-button"
                                    type="submit">
                                <i class="bi bi-box-arrow-right me-1"></i>
                                Sign Out
                            </button>
                        </form>
                    </div>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private static readonly string[] PagesWithoutMenu =
    [
        "login",
        "register"
    ];
    private IJSObjectReference? _module;
    private bool IsDarkMode;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _module = await JSRuntime.InvokeAsync<IJSObjectReference>(
                "import",
                "./Components/Layout/MainLayout.razor.js");
        }
    }

    private async Task ToggleTheme()
    {
        Console.WriteLine("ToggleTheme called");

        if (_module is not null)
        {
            Console.WriteLine("Calling JavaScript...");
            await _module.InvokeVoidAsync("toggleTheme");

            IsDarkMode = !IsDarkMode;
        }
        else
        {
            Console.WriteLine("JS module is NULL!");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
            }
        }
    }

    private bool HideMenu
    {
        get
        {
            var relativePath = NavigationManager
                .ToBaseRelativePath(NavigationManager.Uri)
                .Split('?', '#')[0];

            return PagesWithoutMenu.Contains(
                relativePath,
                StringComparer.OrdinalIgnoreCase);
        }
    }
}
