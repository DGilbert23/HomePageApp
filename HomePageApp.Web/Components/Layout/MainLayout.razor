@using Microsoft.AspNetCore.Components.Authorization
@inject NavigationManager NavigationManager;
@inherits LayoutComponentBase

<div class="page">

    @if (!HideMenu)
    {
        <div class="sidebar">
            <NavMenu />
        </div>
    }

    <main>
        <div class="top-row px-4">
            <AuthorizeView>
                <Authorized>
                    <a class="btn btn-outline-primary btn-lg me-2" href="/changepassword">
                        Change Password
                    </a>

                    <form method="post" action="/account/logout">
                        <button class="btn btn-outline-danger btn-lg" type="submit">
                            Sign Out
                        </button>
                    </form>
                </Authorized>
            </AuthorizeView>
        </div>

        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private static readonly string[] PagesWithoutMenu =
    [
        "login",
        "register"
    ];

    private bool HideMenu
    {
        get
        {
            var relativePath = NavigationManager
                .ToBaseRelativePath(NavigationManager.Uri)
                .Split('?', '#')[0];

            return PagesWithoutMenu.Contains(
                relativePath,
                StringComparer.OrdinalIgnoreCase);
        }
    }
}
