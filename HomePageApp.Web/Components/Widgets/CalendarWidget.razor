@using System.Security.Claims;
@using HomePageApp.Core.Interfaces
@using HomePageApp.Core.Models
@using Microsoft.AspNetCore.Components.Authorization
@inject ICalendarApiService CalendarService
@inject NavigationManager Navigation

@if (!string.IsNullOrEmpty(firstName))
{
    <div class="d-flex align-items-center justify-content-between mb-4 mt-2">
        <div class="d-flex align-items-center gap-1 mb-1">
            <span class="material-symbols-outlined">
                account_circle
            </span>
            <div>Welcome @firstName</div>
        </div>

        <div>
            <button class="btn btn-primary btn-sm" @onclick="HandleSignOut">Sign Out</button>            
        </div>
    </div>
}

@if (CalendarData == null)
{
    <p>Loading Upcoming Events...</p>
}
else
{
    <table class="table text-center align-middle">
        <thead>
            <tr>
                <th>Event title</th>
                <th>Description</th>
                <th>Start Time</th>
                <th>End Time</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (CalendarData data in CalendarData)
            {
                <tr>
                    <td>@data.Title</td>
                    <td>@data.Description</td>
                    <td>@data.StartTime</td>
                    <td>@data.EndTime</td>
                    <td>
                        <a href="@data.HtmlLink" class="">
                            <span class="material-symbols-outlined">
                                arrow_forward
                            </span>
                        </a>
                    </td>                    
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private List<CalendarData>? CalendarData;
    private bool isScriptInitialized = false;
    private string? firstName;
    private string? lastName;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthStateTask != null)
        {
            var authState = await AuthStateTask;
            var user = authState.User;

            if (user.Identity?.IsAuthenticated == true)
            {
                firstName = user.FindFirst(ClaimTypes.GivenName)?.Value ?? user.Identity.Name;
                lastName = user.FindFirst(ClaimTypes.Surname)?.Value;
            }
        }

        CalendarData = await CalendarService.GetUpcomingEventsAsync();
        CalendarData = CalendarData.OrderBy(c => c.StartTime).ToList<CalendarData>();
    }

    private void HandleSignOut()
    {
        Navigation.NavigateTo("account/logout", forceLoad: true);
    }
}
