@using Microsoft.EntityFrameworkCore
@using HomePageApp.Core.Models
@using HomePageApp.Infrastructure
@inject IDbContextFactory<AppDbContext> DbFactory


<div class="card-body p-3">
    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
        <h5 class="m-0 text-primary fw-bold">Active Tasks</h5>
        <span class="badge bg-primary rounded-pill">@todos.Count(t => t.CompletedDate == null) remaining</span>
    </div>

    <div class="bg-light p-2 rounded mb-3 border">
        <div class="row g-2">
            <div class="col-md-7">
                <input type="text" class="form-control form-control-sm"
                       placeholder="Task title..." @bind="newTitle" />
            </div>
            <div class="col-md-3">
                <input type="date" class="form-control form-control-sm"
                       @bind="newDueDate" title="Due Date" />
            </div>
            <div class="col-md-2">
                <button class="btn btn-sm btn-primary w-100" type="button" @onclick="AddTask">Add</button>
            </div>
        </div>
        <div class="mt-2">
            <input type="text" class="form-control form-control-sm"
                   placeholder="Description (optional)..." @bind="newDescription" />
        </div>
    </div>

    @if (todos == null)
    {
        <div class="text-center p-3">
            <div class="spinner-border spinner-border-sm text-secondary" role="status"></div>
        </div>
    }
    else if (!todos.Any())
    {
        <p class="text-muted text-center small my-3">No tasks found. Add one above!</p>
    }
    else
    {
        <div class="list-group list-group-flush">
            @foreach (var item in todos)
            {
                var isDone = item.CompletedDate != null;
                var isEditing = editingTaskId == item.Id;

                <div class="list-group-item px-3 py-3 bg-transparent border-bottom">
                    <div class="row align-items-center g-3">
                        <div class="col-auto">
                            <input class="form-check-input m-0" type="checkbox" checked="@isDone" disabled="@isEditing"
                                   id="todo-@item.Id" @onchange="() => ToggleTaskCompletion(item)" style="transform: scale(1.3); cursor: pointer;" />
                        </div>

                        <div class="col">
                            @if (isEditing)
                            {
                                <div class="mb-2">
                                    <label class="form-label text-muted mb-1 fs-6 fw-medium">Task Title</label>
                                    <input type="text" class="form-control form-control-lg fs-5 fw-semibold"
                                           @bind="editTitle" placeholder="Task title..." />
                                </div>
                                <div>
                                    <label class="form-label text-muted mb-1 fs-6 fw-medium">Description</label>
                                    <textarea class="form-control form-control-lg fs-5" rows="2"
                                              @bind="editDescription" placeholder="Add details or notes (optional)..."></textarea>
                                </div>
                            }
                            else
                            {
                                <div>
                                    <label class="form-check-label fs-5 fw-semibold d-block @(isDone ? "text-decoration-line-through text-muted" : "")"
                                           for="todo-@item.Id" style="cursor: pointer;">
                                        @item.Title
                                    </label>

                                    <!-- Description on its own row below title -->
                                    @if (!string.IsNullOrWhiteSpace(item.Description))
                                    {
                                        <div class="text-muted fs-6 mt-1 text-wrap text-break fw-normal">
                                            @item.Description
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="text-muted opacity-50 fs-6 mt-1 fst-italic">
                                            No description provided.
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <div class="col-md-2 text-md-center">
                            <span class="text-muted d-block small uppercase tracking-wider text-xs mb-1">Created</span>
                            <span class="fs-6 fw-medium bg-light px-2 py-1 rounded d-inline-block">
                                @item.CreatedDate.ToString("MM/dd/yyyy")
                            </span>
                        </div>

                        <div class="col-md-2 text-md-center">
                            @if (isEditing)
                            {
                                <label class="form-label text-muted mb-1 fs-6 fw-medium d-block">Due Date</label>
                                <input type="date" class="form-control form-control-lg fs-6 text-center"
                                       @bind="editDueDate" />
                            }
                            else
                            {
                                @if (isDone)
                                {
                                    <span class="bg-success-subtle text-success px-2 py-1 rounded fw-semibold fs-6 d-inline-block">
                                        ✅ Done: @item.CompletedDate!.Value.ToString("MM/dd/yyyy")
                                    </span>
                                }
                                else if (item.DueDate.HasValue)
                                {
                                    var isOverdue = item.DueDate < DateTime.Today;
                                    <span class="px-2 py-1 rounded fw-semibold fs-6 d-inline-block @(isOverdue ? "bg-danger text-white" : "bg-warning-subtle text-warning-emphasis")">
                                        📅 Due: @item.DueDate.Value.ToString("MM/dd/yyyy")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted opacity-50 fs-6 fst-italic d-inline-block py-1">
                                        No deadline
                                    </span>
                                }
                            }
                        </div>

                        <div class="col-auto ms-auto">
                            <div class="d-flex align-items-center gap-2">
                                @if (isEditing)
                                {
                                    <button class="btn btn-success btn-lg px-3 py-2 fs-6 fw-medium"
                                            @onclick="() => SaveTask(item)" title="Save Changes">
                                        💾 Save
                                    </button>
                                    <button class="btn btn-outline-secondary btn-lg px-3 py-2 fs-6"
                                            @onclick="CancelEdit" title="Cancel Edit">
                                        Cancel
                                    </button>
                                }
                                else
                                {
                                    <button class="btn btn-outline-primary btn-lg px-3 py-2 fs-6 fw-medium"
                                            @onclick="() => StartEdit(item)" title="Edit Task">
                                        ✏️ Edit
                                    </button>
                                }

                                <button class="btn btn-outline-danger btn-lg px-3 py-2 fs-6"
                                        @onclick="() => DeleteTask(item.Id)" title="Delete Task">
                                    🗑️ Delete
                                </button>
                            </div>
                        </div>

                    </div>
                </div>
            }
        </div>

    }
</div>

@code {
    private List<ToDoItem> todos = new();

    private string newTitle = string.Empty;
    private string? newDescription = string.Empty;
    private DateTime? newDueDate;
    private int? editingTaskId;
    private string editTitle = string.Empty;
    private string? editDescription = string.Empty;
    private DateTime? editDueDate;

    protected override async Task OnInitializedAsync()
    {
        await RefreshList();
    }

    private async Task RefreshList()
    {
        using var context = DbFactory.CreateDbContext();
        todos = await context.ToDoItems
                             .OrderBy(t => t.CompletedDate != null)
                             .ThenBy(t => t.DueDate ?? DateTime.MaxValue)
                             .ThenByDescending(t => t.CreatedDate)
                             .ToListAsync();
    }

    private async Task AddTask()
    {
        if (string.IsNullOrWhiteSpace(newTitle)) return;

        using var context = DbFactory.CreateDbContext();

        var task = new ToDoItem
        {
            Title = newTitle.Trim(),
            Description = string.IsNullOrWhiteSpace(newDescription) ? null : newDescription.Trim(),
            CreatedDate = DateTime.Now,
            DueDate = newDueDate,
            CompletedDate = null
        };

        context.ToDoItems.Add(task);
        await context.SaveChangesAsync();

        newTitle = string.Empty;
        newDescription = string.Empty;
        newDueDate = null;

        await RefreshList();
    }

    private async Task ToggleTaskCompletion(ToDoItem item)
    {
        using var context = DbFactory.CreateDbContext();

        if (item.CompletedDate == null)
        {
            item.CompletedDate = DateTime.Now;
        }
        else
        {
            item.CompletedDate = null;
        }

        context.ToDoItems.Update(item);
        await context.SaveChangesAsync();
        await RefreshList();
    }

    private async Task DeleteTask(int id)
    {
        using var context = DbFactory.CreateDbContext();
        var target = await context.ToDoItems.FindAsync(id);

        if (target != null)
        {
            context.ToDoItems.Remove(target);
            await context.SaveChangesAsync();
            await RefreshList();
        }
    }

    // Triggered when clicking the Edit (✏️) button
    private void StartEdit(ToDoItem item)
    {
        editingTaskId = item.Id;
        editTitle = item.Title ?? "";
        editDescription = item.Description;
        editDueDate = item.DueDate;
    }

    // Triggered when clicking the Cancel (×) button during an edit
    private void CancelEdit()
    {
        editingTaskId = null;
        editTitle = string.Empty;
        editDescription = string.Empty;
        editDueDate = null;
    }

    // Triggered when clicking the Save (💾) button
    private async Task SaveTask(ToDoItem item)
    {
        // Don't save if the user cleared out the title
        if (string.IsNullOrWhiteSpace(editTitle)) return;

        using var context = DbFactory.CreateDbContext();

        // Fetch the fresh database tracking entity to avoid concurrency issues
        var target = await context.ToDoItems.FindAsync(item.Id);

        if (target != null)
        {
            // Apply the inline modifications
            target.Title = editTitle.Trim();
            target.Description = string.IsNullOrWhiteSpace(editDescription) ? null : editDescription.Trim();
            target.DueDate = editDueDate;

            context.ToDoItems.Update(target);
            await context.SaveChangesAsync();
        }

        // Reset the state to exit edit mode and refresh UI
        CancelEdit();
        await RefreshList();
    }
}
