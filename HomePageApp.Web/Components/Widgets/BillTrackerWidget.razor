@using HomePageApp.Core.Models.BillTracker
@using HomePageApp.Core.Interfaces.BillTracker

<div class="card-body p-3">
    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
        <span class="badge bg-primary rounded-pill">@billList.Count() bills due in next @_daysOutCheck days</span>
    </div>

    <div class="table-responsive rounded border border-light-subtle shadow-sm bg">
        <table class="table table-hover text-center small">
            <thead class="table text-secondary">
                <tr>
                    <th scope="col" class="ps-3" style="width: 10%;">Bill</th>
                    <th scope="col" style="width: 20%;">Next Due</th>
                    <th scope="col" style="width: 20%;">Est. Amount</th>
                    <th scope="col" style="width: 5%;">AutoDraft</th>
                    <th scope="col" style="width: 15%;">Frequency</th>
                    <th scope="col" style="width: 20%;">Description</th>
                    <th scope="col" style="width: 10%;"></th>
                </tr>
            </thead>
            <tbody>
                @if (billList == null || !billList.Any())
                {
                    <tr>
                        <td colspan="12" class="text-center text-muted py-4">
                            <div class="py-2">No upcoming bills found.</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var bill in billList)
                    {
                        var backgroundClass = bill.AutoDraft ? "" :
                            bill.NextDue < DateTime.Now.AddDays(3) ? "table-danger" :
                            bill.NextDue < DateTime.Now.AddDays(7) ? "table-warning" :
                            "";

                        <tr class="align-middle @(backgroundClass)">
                            <td class="fw-semibold ps-3">
                                @if (!string.IsNullOrEmpty(bill.PaymentUrl))
                                {
                                    <a href="@bill.PaymentUrl" target="_blank" class="text-decoration-none link-color d-inline-flex align-items-center gap-1 border-dark">
                                        @bill.Name
                                        <span class="small" style="font-size: 0.75rem;">↗</span>
                                    </a>
                                }
                                else
                                {
                                    <span class="text">@bill.Name</span>
                                }
                            </td>

                            <td class="text-secondary font-monospace">
                                @bill.NextDue?.ToString("d")
                            </td>

                            <td class="fw-medium text">
                                @if (bill.EstimatedAmountDue.HasValue)
                                {
                                    <span>$@bill.EstimatedAmountDue.Value.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>

                            <td class="text-center align-middle">
                                <div class="d-inline-flex justify-content-center align-items-center form-check form-switch mb-0 p-0">
                                    <input class="form-check-input float-none m-0" type="checkbox" title="Auto-draft?" checked="@bill.AutoDraft" disabled="disabled" />
                                </div>
                            </td>


                            <td>
                                @if (bill.Reoccurring)
                                {
                                    <span class="badge text-bg-info text opacity-75 fw-semibold px-2 py-1 text-capitalize">
                                        @bill.Frequency
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-body border text-secondary fw-normal px-2 py-1">
                                        One-time
                                    </span>
                                }
                            </td>

                            <td class="text-truncate" style="max-width: 200px;" title="@bill.Description">
                                @bill.Description
                            </td>

                            <td>
                                <button class="btn btn-sm btn-primary w-100 fw-bold py-1" type="button" @onclick="() => MarkPaidOrSeen(bill.Id)">
                                    @(bill.AutoDraft ? "Mark Seen" : "Mark Paid")
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</div>

@code {
    private readonly int _daysOutCheck = 14;
    private List<Bill> billList = new();
    [Parameter, EditorRequired]
    public IBillTrackerRepository BillTrackerRepository { get; set; } = default!;

    protected override async Task OnInitializedAsync()
    {
        await RefreshList();
    }

    private async Task RefreshList()
    {
        billList = await BillTrackerRepository.GetUpcomingBillsAsync(_daysOutCheck);
    }

    private async Task MarkPaidOrSeen(int id)
    {
        await BillTrackerRepository.MarkPaidOrSeenAsync(id);
        await RefreshList();
    }
}
