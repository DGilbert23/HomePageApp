@using HomePageApp.Core.Models.BillTracker
@using HomePageApp.Core.Interfaces
@inject IBillTrackerRepository BillTrackerRepository



<div class="card-body p-3">
    <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
        <h5 class="m-0 text-primary fw-bold">Bill Tracker</h5>
        <span class="badge bg-primary rounded-pill">@billList.Count() bills due in next @_daysOutCheck days</span>
    </div>

    <div class="table-responsive rounded border border-light-subtle shadow-sm bg-white">
        <table class="table table-hover text-center small">
            <thead class="table-light text-secondary">
                <tr>
                    <th scope="col" class="ps-3" style="width: 15%;">Bill Title</th>
                    <th scope="col" style="width: 20%;">Next Due</th>
                    <th scope="col" style="width: 20%;">Est. Amount</th>
                    <th scope="col" style="width: 15%;">Frequency</th>
                    <th scope="col" style="width: 20%;">Description</th>
                    <th scope="col" style="width: 10%;"></th>
                </tr>
            </thead>
            <tbody>
                @if (billList == null || !billList.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            <div class="py-2">No upcoming bills found.</div>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var bill in billList)
                    {
                        <tr class="align-middle @(bill.NextDue < DateTime.Now.AddDays(3) ? "table-danger" : bill.NextDue < DateTime.Now.AddDays(7) ? "table-warning" : "")">
                            <!-- Bill Title & Optional Link -->
                            <td class="fw-semibold ps-3">
                                @if (!string.IsNullOrEmpty(bill.PaymentUrl))
                                {
                                    <a href="@bill.PaymentUrl" target="_blank" class="text-decoration-none text-primary d-inline-flex align-items-center gap-1">
                                        @bill.Name
                                        <span class="small" style="font-size: 0.75rem;">↗</span>
                                    </a>
                                }
                                else
                                {
                                    <span class="text-dark">@bill.Name</span>
                                }
                            </td>

                            <!-- Next Due Date -->
                            <td class="text-secondary font-monospace">
                                @bill.NextDue?.ToString("d")
                            </td>

                            <!-- Estimated Amount -->
                            <td class="fw-medium text-dark">
                                @if (bill.EstimatedAmountDue.HasValue)
                                {
                                    <span>$@bill.EstimatedAmountDue.Value.ToString("N2")</span>
                                }
                                else
                                {
                                    <span class="text-muted small">—</span>
                                }
                            </td>

                            <!-- Recurring / Frequency Badge -->
                            <td>
                                @if (bill.Reoccurring)
                                {
                                    <span class="badge text-bg-info text-dark opacity-75 fw-semibold px-2 py-1 text-capitalize">
                                        @bill.Frequency
                                    </span>
                                }
                                else
                                {
                                    <span class="badge text-bg-light border text-secondary fw-normal px-2 py-1">
                                        One-time
                                    </span>
                                }
                            </td>

                            <!-- Description -->
                            <td class="text-muted text-truncate" style="max-width: 200px;" title="@bill.Description">
                                @bill.Description
                            </td>

                            <td>
                                <button class="btn btn-sm btn-primary w-100 fw-bold py-1" type="button" @onclick="() => MarkPaid(bill.Id)">
                                    Mark Paid
                                </button>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>

</div>

@code {
    private readonly int _daysOutCheck = 14;
    private List<Bill> billList = new();
    private string? newName = string.Empty;
    private string? newDescription = string.Empty;
    private bool newReoccurring = false;
    private string? newFrequency;
    private DateTime? newStartDue;
    private double? newEstimatedAmountDue = null;
    private string? newPaymentUrl = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        await RefreshList();
    }

    private async Task RefreshList()
    {
        billList = await BillTrackerRepository.GetUpcomingBillsAsync(_daysOutCheck);
    }

    private async Task MarkPaid(int id)
    {
        await BillTrackerRepository.MarkPaidAsync(id);
        await RefreshList();
    }
}
