@using HomePageApp.Core.Interfaces
@using HomePageApp.Core.Models.WeatherApi
@inject IWeatherApiService WeatherService
@inject IJSRuntime JSRuntime

<div class="weather-card">
    @if (weather == null)
    {
        <p>Loading local forecast...</p>
    }
    else
    {
        <div class="d-flex flex-column flex-sm-row align-items-sm-center justify-content-between gap-3 mb-4 mt-2">
            <div>
                <div class="d-flex align-items-center gap-1 mb-1">
                    <svg xmlns="http://w3.org" width="14" height="14" fill="currentColor" class="text-primary" viewBox="0 0 16 16">
                        <path d="M8 16s6-5.686 6-10A6 6 0 0 0 2 6c0 4.314 6 10 6 10m0-7a3 3 0 1 1 0-6 3 3 0 0 1 0 6" />
                    </svg>
                    <span class="text-uppercase fw-bold text-muted small" style="font-size: 0.75rem; letter-spacing: 0.05em;">Current Location</span>
                </div>
                <h1 class="fw-bold tracking-tight text-dark mb-0 fs-3">
                    @weather.City, <span class="text-secondary fw-normal fs-4">@weather.State</span>
                </h1>
            </div>

            <div class="d-flex align-items-center gap-3 bg-body-tertiary border rounded-4 p-3 shadow-sm">
                <div class="d-flex align-items-center gap-2">
                    <span class="badge bg-secondary-subtle text-secondary-emphasis fw-bold uppercase" style="font-size: 0.6rem; padding: 0.35em 0.5em; letter-spacing: 0.03em;">NOW</span>
                    <span class="fs-1 fw-black text-dark lh-1">@weather.CurrentTempF°F</span>                    
                </div>

                <div class="vr opacity-25 my-1" style="height: 35px;"></div>

                <div class="d-flex align-items-center gap-2">
                    <img src="@weather.ConditionIconUrl" alt="@weather.ConditionText" style="width: 44px; height: 44px; object-fit: contain;">
                    <div class="lh-1">
                        <span class="d-block text-uppercase fw-bold text-muted small mb-1" style="font-size: 0.65rem; letter-spacing: 0.03em;">Condition</span>
                        <span class="fs-6 fw-semibold text-secondary d-block">@weather.ConditionText</span>
                    </div>
                </div>

                <div class="vr opacity-25 my-1" style="height: 35px;"></div>

                <div class="lh-sm text-nowrap" style="min-width: 85px;">
                    <span class="d-block text-uppercase fw-bold text-muted small mb-1" style="font-size: 0.65rem; letter-spacing: 0.03em;">Today's Range</span>

                    <div class="d-flex justify-content-between align-items-center small text-muted fw-medium">
                        <span>High:</span>
                        <span class="text-dark fw-bold ms-3">@weather.TodayMaxTempF°</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center small text-muted fw-medium">
                        <span>Low:</span>
                        <span class="text-dark fw-bold ms-3">@weather.TodayMinTempF°</span>
                    </div>
                </div>
            </div>
        </div>

        <div id="hourly-scroller" class="d-flex overflow-x-auto gap-1 py-3">
            @for (int i = 0; i <= 24; i++)
            {
                var hour = weather.TodayHours[i];

                <div class="flex-shrink-0 flex-nowrap d-flex flex-column align-items-center border border-light-subtle bg-light-subtle rounded-3 p-2 shadow-sm">
                    <div class="text-muted small">@hour.Time</div>
                    <img src="@hour.ConditionIconUrl" alt="Condition" style="width: 48px; height: 48px;">
                    <div>@hour.TempF°F</div>
                    @if (hour.ChanceOfRain > 0)
                    {
                        <div class="text-primary">Rain: @hour.ChanceOfRain%</div>
                    }
                </div>
            }
        </div>

        <table class="table table-borderless align-middle mb-0">
            <tbody>
                @foreach (var day in weather.ForecastFuture)
                {
                    <tr class="border-bottom border-light-subtle">
                        <!-- 1. Day Column -->
                        <td class="text-center fw-semibold text-dark py-2" style="width: 20%;">
                            @day.Date.DayOfWeek.ToString()
                        </td>

                        <!-- 2. Condition Icon Column -->
                        <td class="text-start py-2" style="width: 30%;">
                            <div class="d-flex align-items-center gap-2">
                                <img src="@day.ConditionIconUrl" alt="Condition" style="width: 28px; height: 28px; object-fit: contain; flex-shrink: 0;">
                                <span class="small fw-medium text-secondary text-nowrap">@day.ConditionText</span>
                            </div>
                        </td>

                        <!-- 3. Rain Percentage Column -->
                        <td class="text-start py-2" style="width: 10%;">
                            @if (day.ChanceOfRain > 0)
                            {
                                <div class="d-flex align-items-center gap-1 text-primary small fw-semibold">
                                    <svg width="10" height="10" fill="currentColor" class="bi bi-drop-fill" viewBox="0 0 16 16">
                                        <path d="M8 16a6 6 0 0 0 6-6c0-1.655-1.122-2.904-2.432-4.362C10.254 4.176 8.75 2.503 8 0c-.75 2.503-2.254 4.176-3.568 5.638C3.122 7.096 2 8.345 2 10a6 6 0 0 0 6 6" />
                                    </svg>
                                    <span>@day.ChanceOfRain%</span>
                                </div>
                            }
                            else
                            {
                                <span class="text-muted opacity-50 small">-</span>
                            }
                        </td>

                        <!-- 4. Low Temperature Column -->
                        <td class="text-center text-muted small fw-medium py-2" style="width: 20%;">
                            Low: <span class="text-secondary fw-semibold">@day.MinTempF°</span>
                        </td>

                        <!-- 5. High Temperature Column -->
                        <td class="text-center text-dark fw-bold py-2" style="width: 20%;">
                            High: <span>@day.MaxTempF°</span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    private WeatherData? weather;
    private bool isScriptInitialized = false;    

    protected override async Task OnInitializedAsync()
    {
        weather = await WeatherService.GetWidgetWeatherAsync("35803");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (weather != null && !isScriptInitialized)
        {
            isScriptInitialized = true;
            await JSRuntime.InvokeVoidAsync("initHorizontalMouseWheel", "hourly-scroller");
        }
    }
}
