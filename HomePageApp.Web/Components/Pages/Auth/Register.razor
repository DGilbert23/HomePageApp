@page "/register"
@using Microsoft.AspNetCore.Authorization;
@attribute [AllowAnonymous]

<PageTitle>Register</PageTitle>

<div class="login-page d-flex justify-content-center align-items-center">
    <div class="card shadow border-0 rounded-4 login-card">
        <div class="card-body p-4 p-md-5">

            <h1 class="text-center mb-1">Feature unavailable</h1>

            <p class="text-center text-muted mb-4">
                Account registration is currently unavailable. Please check back later.
            </p>    
            
            <a class="btn btn-primary w-100 mt-3" href="/login">
                Return to Login
            </a>
        </div>
    </div>
</div>