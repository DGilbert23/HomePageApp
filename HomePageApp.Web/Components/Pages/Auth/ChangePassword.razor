@page "/changepassword"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization;
@attribute [Authorize]
@using HomePageApp.Core.Contracts.Accounts
@using HomePageApp.Core.Interfaces.Identity
@inject IUserAccountService UserAccountService

<PageTitle>Change Password</PageTitle>

<div class="login-page d-flex justify-content-center align-items-center">
    <div class="card shadow border-0 rounded-4 login-card">
        <div class="card-body p-4 p-md-5">

            <h1 class="text-center mb-1">Change Password</h1>

            <p class="text-center text-muted mb-4">
                Enter your current password and choose a new one.
            </p>

            <EditForm Model="Model" OnValidSubmit="ChangeUserPassword">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label">
                        Current Password
                    </label>

                    <InputText @bind-Value="Model.CurrentPassword"
                               type="password"
                               autocomplete="current-password"
                               class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        New Password
                    </label>

                    <InputText @bind-Value="Model.NewPassword"
                               type="password"
                               autocomplete="new-password"
                               class="form-control" />
                </div>

                <div class="mb-3">
                    <label class="form-label">
                        Confirm New Password
                    </label>

                    <InputText @bind-Value="Model.ConfirmPassword"
                               type="password"
                               autocomplete="new-password"
                               class="form-control" />
                </div>

                @if (Errors.Count > 0)
                {
                    <div class="alert alert-danger">
                        <ul class="mb-0">
                            @foreach (var error in Errors)
                            {
                                <li>@error</li>
                            }
                        </ul>
                    </div>
                }

                @if (ChangeSucceeded)
                {
                    <div class="alert alert-success">
                        Password changed successfully.
                    </div>
                }

                <button class="btn btn-primary w-100" type="submit">
                    Change Password
                </button>

            </EditForm>

        </div>
    </div>
</div>

@code {
    private ChangePasswordRequest Model { get; set; } = new();

    private List<string> Errors { get; set; } = [];

    private bool ChangeSucceeded;

    private async Task ChangeUserPassword()
    {
        Errors.Clear();
        ChangeSucceeded = false;

        if (Model.NewPassword != Model.ConfirmPassword)
        {
            Errors.Add("The new password and confirmation password do not match.");
            return;
        }

        var result = await UserAccountService.ChangeUserPasswordAsync(
            Model.CurrentPassword,
            Model.NewPassword);

        if (result.Succeeded)
        {
            ChangeSucceeded = true;
            Model = new();
        }
        else
        {
            Errors.AddRange(result.Errors);
        }
    }
}