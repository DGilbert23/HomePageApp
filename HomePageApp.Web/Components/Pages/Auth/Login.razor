@page "/login"

<h3>Login</h3>

<form method="post" action="/account/login">

    <div>
        <label>Email</label>
        <input name="Email" type="email" />
    </div>

    <div>
        <label>Password</label>
        <input name="Password" type="password" />
    </div>

    <button type="submit">
        Login
    </button>

</form>