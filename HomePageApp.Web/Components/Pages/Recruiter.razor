@page "/Recruiter"
@using Microsoft.AspNetCore.Authorization;
@attribute [AllowAnonymous]

<PageTitle>Recruiter</PageTitle>

<div class="container py-5">

    <section class="text-center py-3">
        <div class="mb-3">
            <span class="badge text-bg-secondary px-3 py-2">
                Software Developer
            </span>
        </div>

        <h1 class="display-4 fw-bold mb-3">
            David Gilbert
        </h1>

        <p class="lead text-body-secondary mx-auto" style="max-width: 950px;">
            Software Developer with 8 years of experience. I pride myself on my customer-centric approach to problems, ensuring that I leave users with a solution that makes their lives easier.
        </p>

        <div class="d-flex justify-content-center gap-2 mt-4">
            <a href="/demo/" class="btn btn-primary btn-lg">
                <i class="bi bi-play-circle me-2"></i>
                Explore the Demo
            </a>

            <a href="/downloads/David Gilbert - Resume.pdf" class="btn btn-outline-secondary btn-lg" download>
                <i class="bi bi-file-earmark-pdf me-2"></i>
                Resume
            </a>
        </div>
    </section>


    <section class="py-3">
        <div class="row justify-content-center py-3">

            <div class="col-lg-9">

                <h2 class="fw-bold mb-3">
                    About Me
                </h2>

                <p>
                    Over the last 8 years, I have worked with various different technologies; Microsoft's tech-stack, Oracle DB with Linux systems, etc. I have worked in both the Higher
                    Education and Defense Contractor industries. I have worked closely with so many types of data from financial and human resource data to student coursework and curriculum.
                    Through it all I have learned that the most important part of what I do is <strong>who I do it for</strong>.
                </p>

                <p>
                    I have been fortunate enough to be able to interact directly with the people that I am developing solutions for. That experience has taught me how to bridge the gap
                    between the technical and the practical, leading me to develop tailored solutions that truly solve the specific pain-points that each customer feels. I believe that
                    removing friction so that others can do their jobs better is what I can best contribute to a business.
                </p>

                <p>
                    I enjoy taking complex problems, understanding what people actually need, and turning those needs into software that is useful, reliable, and easy to work with.
                    <em>HomePageApp</em> is a reflection of that approach: a project where I can explore new technologies while continuing to focus on solving real problems for real users.
                </p>

                <!-- Social / professional links -->
                <div class="d-flex justify-content-center flex-wrap gap-2 mt-4">

                    <a href="https://github.com/DGilbert23" class="btn btn-outline-secondary">
                        <i class="bi bi-github me-2"></i>
                        GitHub
                    </a>

                    <a href="http://linkedin.com/in/dgilbert230" class="btn btn-outline-secondary">
                        <i class="bi bi-linkedin me-2"></i>
                        LinkedIn
                    </a>

                    <a href="mailto:dgilbert230@gmail.com" class="btn btn-outline-secondary">
                        <i class="bi bi-envelope me-2"></i>
                        Contact
                    </a>
                </div>
            </div>
        </div>
    </section>


    <section class="py-3">
        <h2 class="fw-bold text-center mb-5">
            Development Experience
        </h2>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <h3 class="h5 fw-bold">
                            <i class="bi bi-code-slash me-2"></i>
                            Full-Stack Development
                        </h3>

                        <p class="text-body-secondary mb-0">
                            With 8 years of Full-Stack Development experience,
                            split between Microsoft and Oracle/Linux environments,
                            I bring a broad perspective on software development,
                            from building intuitive user experiences to designing
                            reliable backend systems and everything in between.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <h3 class="h5 fw-bold">
                            <i class="bi bi-headset me-2"></i>
                            Customer Satisfaction
                        </h3>

                        <p class="text-body-secondary mb-0">
                            As a developer, my goal is to provide the customer
                            with what they <strong><em>need</em></strong>. I am experienced
                            in working directly with customers to help them identify what
                            exactly they need for their business & delivering timely solutions.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100">
                    <div class="card-body p-4">
                        <h3 class="h5 fw-bold">
