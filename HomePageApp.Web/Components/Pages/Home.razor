@page "/"
@using HomePageApp.Web.Components.Widgets
@using Microsoft.AspNetCore.Components.Authorization
@rendermode InteractiveServer

<PageTitle>Personal Dashboard</PageTitle>

<div class="container-fluid py-4">
    <div class="row g-4">

        <!-- Left Side: Weather and Calendar widgets -->
        <div class="col-md-6 col-lg-4">
            <div class="card shadow-sm p-3 mb-4 bg-light">
                <WeatherWidget />
            </div>

            <div class="card shadow-sm p-3 bg-light">
                <h5 class="border-bottom pb-2">Calendar Plugin</h5>
                <AuthorizeView>
                    <Authorized>
                        <span class="me-3">Hello, @context.User.Identity?.Name!</span>
                        <a class="btn btn-outline-danger btn-sm" href="account/logout" @onclick="HandleSignOut">Sign Out</a>
                    </Authorized>
                    <NotAuthorized>
                        <a class="btn btn-primary btn-sm" href="account/login">Sign In with Google</a>
                    </NotAuthorized>
                </AuthorizeView>
            </div>
        </div>

        <!-- Right Side: Your modular CRUD item -->
        <div class="col-md-6 col-lg-8">
            <div class="card shadow-sm bg-light">
                <!-- Drop your custom component like a standard HTML tag -->
                <ToDoWidget />
            </div>
        </div>

    </div>
</div>

@code {
    [Inject]
    private NavigationManager Navigation { get; set; } = default!;

    private void HandleSignOut()
    {     
        Navigation.NavigateTo("account/logout", forceLoad: true);
    }
}
